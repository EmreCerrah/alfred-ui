# Phase 3 server-only environment variables.
# These variables are used exclusively by the Next.js server (API routes / route handlers).
# They must NEVER be prefixed with NEXT_PUBLIC_ — doing so would expose them to the browser.

# WebSocket URL of the OpenClaw Gateway (server-side only)
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# Auth token for the OpenClaw Gateway (server-side only — NEVER use NEXT_PUBLIC_ prefix)
OPENCLAW_GATEWAY_TOKEN=
